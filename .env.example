# =========================
# Application
# =========================
APP_NAME=AxeDz
NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# =========================
# Database (PostgreSQL)
# =========================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=auth_db
DB_USER=postgres
DB_PASSWORD=change_me

# =========================
# JWT / Auth
# =========================
JWT_SECRET=replace_with_a_strong_random_secret
JWT_LIFETIME=15m
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret
JWT_REFRESH_LIFETIME=30d
REFRESH_COOKIE_MAX_AGE_MS=2592000000

# OTP settings
OTP_EXP_MINUTES=15

# =========================
# CORS / Security
# =========================
# Comma-separated allowed origins
CORS_ALLOWLIST=http://localhost:3000,http://localhost:5173
# Keep false outside local tests
CORS_ALLOW_ALL=false

# Global API limits
RATE_LIMIT_MAX=300

# Auth route specific limits
AUTH_RATE_LIMIT_MAX=20
BRUTE_FORCE_DELAY_AFTER=5
BRUTE_FORCE_DELAY_MS=500
BRUTE_FORCE_MAX_DELAY_MS=5000

# =========================
# Mail
# =========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# =========================
# Frontend URLs
# =========================
FRONT_SIDE_URL=https://yourfrontend.com
FRONTEND_URL=https://yourfrontend.com
FRONT_URL_CALLBACK=https://yourfrontend.com/auth/google/callback

# =========================
# Google OAuth
# =========================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://yourbackend.com/auth/google/callback
SESSION_SECRET=your_session_secret

# =========================
# AWS S3
# =========================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your_s3_bucket
AWS_ENDPOINT=https://s3.amazonaws.com

# =========================
# SMS (integrate with real provider)
# =========================
MAIL_USER=mailer@example.com
MAIL_PASS=replace_with_mail_password

# =========================
# Google OAuth
# =========================
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
SESSION_SECRET=replace_with_session_secret
FRONT_URL_CALLBACK=http://localhost:5173/auth/callback


